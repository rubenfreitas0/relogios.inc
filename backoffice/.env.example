# Chave do Google Tag Manager (opcional)
VITE_APP_GTM_KEY=

# Define se as páginas/componentes de demonstração do template Vuestic devem ser incluídas nas rotas (true/false)
VITE_APP_INCLUDE_DEMOS=true

# Define se o modo de histórico do Vue Router está ativo (true para 'history', false para 'hash')
VITE_APP_ROUTER_MODE_HISTORY=true

# Versão do build da aplicação para exibição no painel
VITE_APP_BUILD_VERSION=1.0.0

# URL base da API do backend Laravel (ex: http://localhost:8000/api)
VITE_API_BASE_URL=http://localhost:8000/api
