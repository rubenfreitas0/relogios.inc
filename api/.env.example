# Nome da Aplicação
APP_NAME=Laravel

# Ambiente de execução (local, testing, production)
APP_ENV=local

# Chave criptográfica da aplicação (gerada via php artisan key:generate)
APP_KEY=

# Modo de depuração ativo (exibe erros detalhados - true/false)
APP_DEBUG=true

# URL base da API
APP_URL=http://localhost:8000

# URL do frontend da loja/backoffice para redirecionamentos (ex: reset de password)
FRONTEND_URL=http://localhost:5173

# Idioma padrão da aplicação
APP_LOCALE=pt_PT

# Idioma de fallback (segurança se a tradução falhar)
APP_FALLBACK_LOCALE=en

# Localização das factories para geração de dados falsos de teste
APP_FAKER_LOCALE=pt_PT

# Driver de controle de manutenção
APP_MAINTENANCE_DRIVER=file

# Número de rounds para encriptação bcrypt das passwords
BCRYPT_ROUNDS=12

# Definições de logs da aplicação
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Ligação à Base de Dados (ex: pgsql, mysql, sqlite)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=relogios_inc
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Gestão de Sessões
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Conexões e Filas de Trabalho (Queue/Cache)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Configuração do Memcached (opcional)
MEMCACHED_HOST=127.0.0.1

# Configuração do Redis (opcional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuração de envio de e-mails (para envio local pode usar log ou mailpit)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@relogios.inc"
MAIL_FROM_NAME="${APP_NAME}"

# Integração com AWS S3 (armazenamento externo opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Nome do App exportado para o Vite
VITE_APP_NAME="${APP_NAME}"
